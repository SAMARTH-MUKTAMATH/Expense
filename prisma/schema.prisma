generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(uuid())
  clerkUserId   String    @unique
  email         String    @unique
  name          String?
  imageUrl      String?
  transactions  Transaction[]
  accounts      Account[]
  budgets       Budget[]
  createdGroups Group[]   @relation("CreatedGroups")
  financialReports FinancialReport[]

  ingestTokenHash  String?   @unique // SHA-256 hash only, never the raw token
  ingestTokenSetAt DateTime?
  ingestLastSeenAt DateTime?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("users")
}

model Account {
  id           String        @id @default(uuid())
  name         String
  type         AccountType
  balance      Decimal       @default(0)
  isDefault    Boolean       @default(false)
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Transaction {
  id                String            @id @default(uuid())
  type             TransactionType
  amount           Decimal
  description      String?
  date             DateTime
  category         String           
  receiptUrl       String?
  isRecurring      Boolean           @default(false)
  recurringInterval RecurringInterval? // only used when isRecurring
  nextRecurringDate DateTime?
  lastProcessed    DateTime?
  status           TransactionStatus  @default(COMPLETED)
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId        String
  account          Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)

  source           TransactionSource @default(MANUAL)
  referenceId      String? // UPI RRN / bank reference; the dedupe key
  rawMessage       String?  @db.Text
  merchantName     String?
  parseConfidence  Float? // 0..1, NULL for manual rows
  needsReview      Boolean  @default(false)

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([userId, referenceId])
  @@index([userId])
  @@index([accountId])
  @@index([userId, needsReview])
  @@map("transactions")
}


model Budget {
  id          String       @id @default(uuid())
  amount      Decimal
  lastAlertSent DateTime?
  userId      String       @unique
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([userId])
  @@map("budgets")
}

model Group {
  id          String         @id @default(uuid())
  name        String
  description String?
  createdById String
  createdBy   User           @relation("CreatedGroups", fields: [createdById], references: [id], onDelete: Cascade)
  members     GroupMember[]
  expenses    GroupExpense[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([createdById])
  @@map("groups")
}

model GroupMember {
  id        String         @id @default(uuid())
  groupId   String
  group     Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name      String
  email     String
  shares    ExpenseShare[]
  createdAt DateTime       @default(now())

  @@index([groupId])
  @@map("group_members")
}

model GroupExpense {
  id          String         @id @default(uuid())
  groupId     String
  group       Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  description String
  amount      Decimal
  paidByName  String
  createdAt   DateTime       @default(now())
  shares      ExpenseShare[]

  @@index([groupId])
  @@map("group_expenses")
}

model ExpenseShare {
  id         String        @id @default(uuid())
  expenseId  String
  expense    GroupExpense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  memberId   String
  member     GroupMember   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  amount     Decimal
  settled    Boolean       @default(false)
  settledAt  DateTime?
  notifiedAt DateTime?

  @@unique([expenseId, memberId])
  @@index([expenseId])
  @@index([memberId])
  @@map("expense_shares")
}

model FinancialReport {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  monthKey        String    // "YYYY-MM" — the month the report covers
  contentMarkdown String    @db.Text
  healthScore     Int?
  source          String    @default("cron")     // "cron" | "on-demand"
  deliveryMode    String    @default("web")      // "web" | "email"
  emailSentAt     DateTime?
  createdAt       DateTime  @default(now())

  @@index([userId, createdAt])
  @@map("financial_reports")
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum AccountType {
  CURRENT
  SAVINGS
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum TransactionSource {
  MANUAL
  SMS
  RECEIPT
}

enum RecurringInterval {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}